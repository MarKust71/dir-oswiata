// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  STUDENT
}

enum AccountStatus {
  PENDING_EMAIL
  PENDING_APPROVAL
  ACTIVE
  DISABLED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  role               Role                @default(STUDENT)
  status             AccountStatus       @default(PENDING_EMAIL)
  emailVerifiedAt    DateTime?
  firstName          String?
  lastName           String?
  phone              String?
  // Losowo wskazane pozycje (0-10) numeru PESEL, ktore uzytkownik wpisal przy rejestracji,
  // oraz odpowiadajace im cyfry - do recznej weryfikacji tozsamosci przez administratora.
  peselPositions     Int[]               @default([])
  peselDigits        String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  verificationTokens VerificationToken[]
}

model Settings {
  key   String @id
  value String
}

// Wyniki egzaminów importowane z pliku Excel (kolejność i nazwy pól odpowiadają
// nagłówkom pierwszego wiersza arkusza: Praktyka, Teoria, Końcowa, Ocena ustna,
// Ocena pisemna, zawód, Imię, Nazwisko, Pesel, Nr wniosku).
model Results {
  id                String   @id @default(cuid())
  practicalScore    Int
  theoryScore       Int
  finalScore        Int
  oralScore         Int
  writtenScore      Int
  profession        String
  firstName         String
  lastName          String
  pesel             String
  applicationNumber String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
