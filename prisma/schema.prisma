// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  STUDENT
}

enum AccountStatus {
  PENDING_EMAIL
  PENDING_APPROVAL
  ACTIVE
  DISABLED
}

enum EventType {
  REGISTRATION_SUBMITTED
  REGISTRATION_BLOCKED_RATE_LIMIT
  REGISTRATION_BLOCKED_DUPLICATE_RESULT
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFICATION_RESENT
  EMAIL_VERIFIED
  ACCOUNT_PENDING_APPROVAL
  ACCOUNT_ACTIVATED
  ACCOUNT_ACTIVATED_SKIP_EMAIL_VERIFICATION
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETED
  ACCOUNT_ROLE_CHANGED
  ACCOUNT_LOCKED_APPLICATION_NUMBER
  ACCOUNT_LOCKED_RESULTS_VIEW_LIMIT
  APPLICATION_NUMBER_VERIFIED
  APPLICATION_NUMBER_REJECTED
  PROFILE_CORRECTED
  PROFILE_EDIT_BLOCKED_DUPLICATE_RESULT
  RESULTS_IMPORTED
  RESULTS_RELINKED
  RESULTS_VIEWED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  SETTINGS_CHANGED
  DB_BACKUP_CREATED
  DB_BACKUP_RESTORED
  EMAIL_SEND_FAILED
  EMAIL_SEND_SKIPPED_HOURLY_LIMIT
}

model User {
  id                        String              @id @default(cuid())
  email                     String              @unique
  passwordHash              String
  role                      Role                @default(STUDENT)
  status                    AccountStatus       @default(PENDING_EMAIL)
  emailVerifiedAt           DateTime?
  firstName                 String?
  lastName                  String?
  phone                     String?
  // Losowo wskazane pozycje (0-10) numeru PESEL, ktore uzytkownik wpisal przy rejestracji,
  // oraz odpowiadajace im cyfry - do recznej weryfikacji tozsamosci przez administratora.
  peselPositions            Int[]               @default([])
  peselDigits               String[]            @default([])
  // Powiązanie 1:1 z odnalezionym automatycznie (przy aktywacji konta) rekordem
  // wyniku egzaminu - zob. src/lib/results-matching.ts.
  resultId                  String?             @unique
  result                    Results?            @relation(fields: [resultId], references: [id])
  // Weryfikacja tożsamości numerem wniosku w okresie udostępnienia wyników
  // (results_visible_from/until) - zob. src/app/actions/verify-application-number.ts.
  // Pytanie o numer wniosku pada za każdym razem (brak flagi "zweryfikowano na stałe").
  // Po 3 błędnych próbach ORAZ po 3 poprawnych wyświetleniach wyników konto
  // zostaje zablokowane (status DISABLED) - to dwa niezależne liczniki/limity.
  applicationNumberAttempts Int                 @default(0)
  resultsViewCount          Int                 @default(0)
  // Znacznik czasu ostatniego powiadomienia administratora o braku wyniku dla
  // tego konta w okresie udostępniania wyników - zob.
  // src/lib/missing-result-notification.ts. Ogranicza wysyłkę do raz na dobę
  // na użytkownika.
  missingResultNotifiedAt   DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  verificationTokens        VerificationToken[]
}

model Settings {
  key   String @id
  value String
}

// Wyniki egzaminów importowane z pliku Excel (kolejność i nazwy pól odpowiadają
// nagłówkom pierwszego wiersza arkusza: Praktyka, Teoria, Końcowa, Ocena ustna,
// Ocena pisemna, zawód, Imię, Nazwisko, Pesel, Nr wniosku).
model Results {
  id                String   @id @default(cuid())
  practicalScore    Int
  theoryScore       Int
  finalScore        Int
  oralScore         Int
  writtenScore      Int
  profession        String
  firstName         String
  lastName          String
  pesel             String
  applicationNumber String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Rejestruje udane próby rejestracji (te, które wysłały e-mail weryfikacyjny)
// wg adresu IP - do ograniczenia tempa rejestracji (zob. registerAction w
// src/app/actions/auth.ts). Dane krótkotrwałe (czyszczone po upływie okna
// limitu) - celowo pominięte w kopii zapasowej bazy (src/lib/db-backup.ts).
model RegistrationAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Rejestruje każdą faktyczną próbę wysyłki e-maila (niezależnie od
// powodzenia) - do pilnowania godzinowego limitu wysyłki narzuconego przez
// dostawcę SMTP (OVH: 200 e-maili/h dla tej skrzynki) - zob. src/lib/mailer.ts.
// Dane krótkotrwałe - celowo pominięte w kopii zapasowej bazy
// (src/lib/db-backup.ts).
model EmailSendLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Trwały log zdarzeń aplikacji - niezależny od dostarczalności e-maili (zob.
// src/lib/mailer.ts - wysyłka bywa zawodna, np. blokada konta SMTP przez
// dostawcę) i od logów serwera (ulotnych na Vercel). Celowo bez @relation do
// User - wpis ma przetrwać usunięcie konta (deleteAccountAction), dlatego
// e-mail/id aktora i celu są zapisane jako zwykłe, zdenormalizowane pola.
// IP i user-agent to dane osobowe - widoczne tylko dla ADMIN, wymagają
// polityki retencji (czyszczenie starszych wpisów).
model EventLog {
  id           String    @id @default(cuid())
  type         EventType
  message      String
  actorEmail   String?
  actorUserId  String?
  targetEmail  String?
  targetUserId String?
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([type, createdAt])
  @@index([targetUserId])
  @@index([actorUserId])
}
